# Copie para .env e preencha. O .env NAO vai para o git.

# Postgres (EasyPanel). Use a URL de conexao interna quando a app roda no mesmo EasyPanel,
# e a externa quando roda fora (ex.: maquina local).
DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=disable

# Senha separada, so para abrir o painel de resultados
SENHA_ADMIN=troque-esta-senha

# Chave de assinatura dos cookies de sessao (qualquer string longa e aleatoria)
SECRET_KEY=troque-por-uma-string-longa-e-aleatoria

# Onde este formulario grava. Tabela dedicada, nao mexe em nenhuma outra.
DIAG_SCHEMA=dashboard_tvsim
DIAG_TABELA=diagnostico_cozinha
